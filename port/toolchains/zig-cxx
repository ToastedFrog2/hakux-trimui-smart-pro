#!/bin/bash
port_root="$(cd "$(dirname "$0")/.." && pwd)"
args=("-ffile-prefix-map=$port_root=." "-ffile-prefix-map=$HOME=/build-user")
for arg in "$@"; do
    case "$arg" in
        -march=armv8-a+crc) args+=("-mcpu=cortex_a53");;
        *) args+=("$arg");;
    esac
done
exec "${ZIG:-zig}" c++ -target aarch64-linux-gnu.2.33 "${args[@]}"
