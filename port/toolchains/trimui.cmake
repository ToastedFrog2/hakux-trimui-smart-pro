set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(PORT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${PORT_ROOT}/toolchains/zig-cc")
set(CMAKE_CXX_COMPILER "${PORT_ROOT}/toolchains/zig-cxx")
set(CMAKE_ASM_COMPILER "${PORT_ROOT}/toolchains/zig-cc")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF CACHE BOOL "Zig has no clang-scan-deps" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Needed for target ABI checks" FORCE)
set(CMAKE_SKIP_RPATH ON CACHE BOOL "Use device system libraries" FORCE)
set(CMAKE_AR "${PORT_ROOT}/toolchains/zig-ar")
set(CMAKE_RANLIB "${PORT_ROOT}/toolchains/zig-ranlib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
